{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Properties": {
      "Application": "CustomerSupportCrm.Api"
    }
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "InitializeOnStartup": false
  },
  "Jwt": {
    "Issuer": "customer-support-crm-api",
    "Audience": "customer-support-crm-web",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminDisplayName": "Administrator",
    "AdminPassword": ""
  },
  "AllowedHosts": "*"
}
