{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Properties": {
      "Application": "CustomerSupportCrm.Api"
    }
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "InitializeOnStartup": false
  },
  "Jwt": {
    "Issuer": "customer-support-crm-api",
    "Audience": "customer-support-crm-web",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14,
    "PortalTokenLifetimeHours": 8
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Public": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 26214400
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminDisplayName": "Administrator",
    "AdminPassword": "",
    "OrganizationName": "Customer Support"
  },
  "Storage": {
    "RootPath": "App_Data/storage"
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Channels": {
    "Email": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": ""
    },
    "WhatsApp": {
      "Enabled": false,
      "PhoneNumberId": "",
      "AccessToken": "",
      "AppSecret": "",
      "VerifyToken": ""
    },
    "Sms": {
      "Enabled": false,
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": "",
      "ApiBaseUrl": "https://api.twilio.com"
    }
  },
  "Portal": {
    "BaseUrl": "http://localhost:4200/portal"
  },
  "Ai": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "claude-opus-5-5",
    "UseRefusalFallback": true
  },
  "AllowedHosts": "*"
}
